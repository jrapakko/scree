#!/bin/sh
# scree-mcp: run `scree serve` for Claude Code with settings from the scree
# env file, so the API key never has to be stored in Claude Code's config.
#
#   claude mcp add scree --scope user -- ~/.local/bin/scree-mcp
#
# SCREE_ENV_FILE  env file (default ${XDG_CONFIG_HOME:-$HOME/.config}/scree/env)
# SCREE_BIN       scree binary (default: scree on PATH)
set -eu

env_file=${SCREE_ENV_FILE:-${XDG_CONFIG_HOME:-$HOME/.config}/scree/env}
# "." searches PATH for a name without a slash.
case $env_file in */*) ;; *) env_file=./$env_file ;; esac

if [ ! -f "$env_file" ]; then
	echo "scree-mcp: $env_file not found; create it with SCREE_NOTES and OPENROUTER_API_KEY, then: chmod 600 $env_file" >&2
	exit 1
fi
# GNU stat first, then BSD/macOS stat.
mode=$(stat -c %a "$env_file" 2>/dev/null || stat -f %Lp "$env_file" 2>/dev/null || true)
case $mode in
'' | *[!0-7]*)
	echo "scree-mcp: cannot read the mode of $env_file" >&2
	exit 1
	;;
esac
if [ $((0$mode & 077)) -ne 0 ]; then
	echo "scree-mcp: $env_file is open to group or others (mode $mode); fix with: chmod 600 $env_file" >&2
	exit 1
fi

set -a
. "$env_file"
set +a

exec "${SCREE_BIN:-scree}" serve "$@"
