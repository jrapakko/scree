[Unit]
Description=scree: keep the markdown notes index current
After=network-online.target

[Service]
EnvironmentFile=%h/.config/scree/env
# Change -notes to the folder to keep current.
ExecStart=%h/.local/bin/scree watch -notes %h/notes
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
