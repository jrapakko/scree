#!/bin/sh
# scree-mcp-docker: run `scree serve` in a container for Claude Code with
# settings from the scree env file, so the API key never has to be stored in
# Claude Code's config. The key reaches the container through the
# environment, never the command line.
#
# It mounts the git work tree of its working directory read-only at its own
# host path, so each repo gets its own index in the data volume, and refuses
# to start if CLAUDE_PROJECT_DIR is in another repo. Install it
# as scree-mcp, the name a repo's committed .mcp.json uses, then from the
# repo's root:
#
#   install -m 755 contrib/scree-mcp-docker ~/.local/bin/scree-mcp
#   claude mcp add scree --scope project -- scree-mcp
#
# Settings are read from ~/.config/scree/env, where ~ is your home directory
# in the password database. Besides scree's own, it can set:
# SCREE_DOCKER       docker (default) or podman
# SCREE_IMAGE        image (default scree:latest)
# SCREE_DATA_VOLUME  index volume (default scree-data)
# SCREE_MOUNT_OPTS   options for the folder mount (default ro). On SELinux
#                    hosts, ro,z makes it readable but permanently relabels
#                    every file in the folder on the host.
set -eu
prog=scree-mcp-docker

# Before anything else runs: a project's .mcp.json sets this process's
# environment, PATH included, so no program may be found through the
# inherited PATH, and CDPATH must not steer cd. PATH is reset and every
# SCREE_*, key and proxy variable is cleared before the env file is read, so
# nothing inherited chooses the binary, the endpoint or the key.
PATH=/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin
export PATH
unset CDPATH
for v in $(env | sed -n 's/^\(SCREE_[A-Za-z0-9_]*\)=.*/\1/p') OPENROUTER_API_KEY HTTP_PROXY HTTPS_PROXY NO_PROXY http_proxy https_proxy no_proxy; do
	unset "$v" 2>/dev/null || true
done

# The env file is always ~/.config/scree/env, with ~ taken from the password
# database (the shell's ~user expansion, which calls getpwnam), never from
# $HOME or $XDG_CONFIG_HOME: a project's .mcp.json can set those, and the
# repo must not choose which settings file is loaded.
# BEGIN passwd home (contrib_test.go runs this block alone and replaces it)
# id by absolute path, never through PATH.
idcmd=
for c in /usr/bin/id /bin/id; do
	if [ -x "$c" ]; then
		idcmd=$c
		break
	fi
done
user=
if [ -n "$idcmd" ]; then
	user=$("$idcmd" -un 2>/dev/null) || user=
fi
case $user in
'' | [!A-Za-z0-9_]* | *[!A-Za-z0-9._@-]*)
	echo "$prog: cannot look up your user name (id -un)" >&2
	exit 1
	;;
esac
eval "pwhome=~$user"
case $pwhome in
/*) ;;
*)
	echo "$prog: cannot find the home directory of $user" >&2
	exit 1
	;;
esac
# END passwd home
env_file=$pwhome/.config/scree/env
here=$(cd "$(dirname "$0")" && pwd -P)

if [ ! -f "$env_file" ]; then
	echo "scree-mcp-docker: $env_file not found; create it with OPENROUTER_API_KEY, then: chmod 600 $env_file" >&2
	exit 1
fi
# GNU stat first, then BSD/macOS stat.
mode=$(stat -c %a "$env_file" 2>/dev/null || stat -f %Lp "$env_file" 2>/dev/null || true)
case $mode in
'' | *[!0-7]*)
	echo "scree-mcp-docker: cannot read the mode of $env_file" >&2
	exit 1
	;;
esac
if [ $((0$mode & 077)) -ne 0 ]; then
	echo "scree-mcp-docker: $env_file is open to group or others (mode $mode); fix with: chmod 600 $env_file" >&2
	exit 1
fi
uid=$(stat -c %u "$env_file" 2>/dev/null || stat -f %u "$env_file" 2>/dev/null || true)
if [ "$uid" != "$(id -u)" ]; then
	echo "$prog: $env_file is not owned by you" >&2
	exit 1
fi

if [ $# -gt 0 ]; then
	# Settings belong in the env file; arguments could come from a repo's .mcp.json.
	echo "scree-mcp-docker: takes no arguments; put settings in $env_file" >&2
	exit 1
fi
# Read the env file as data, never as shell: each line is NAME=value, with an
# optional "export " and optional matching quotes around the value. Nothing
# in a value is expanded or run, so spaces, $(...) and backquotes are kept as
# they are. Only scree's own variables and the proxy variables are accepted.
cr=$(printf '\r')
lineno=0
while IFS= read -r line || [ -n "$line" ]; do
	lineno=$((lineno + 1))
	line=${line%"$cr"}
	line=${line#"${line%%[![:space:]]*}"}
	case $line in '' | '#'*) continue ;; esac
	line=${line#export }
	case $line in
	*=*) ;;
	*)
		echo "$prog: $env_file line $lineno: expected NAME=value" >&2
		exit 1
		;;
	esac
	name=${line%%=*}
	value=${line#*=}
	case $name in
	SCREE_[A-Z0-9_]* | OPENROUTER_API_KEY | HTTP_PROXY | HTTPS_PROXY | NO_PROXY | http_proxy | https_proxy | no_proxy) ;;
	*)
		echo "$prog: $env_file line $lineno: $name is not a scree setting" >&2
		exit 1
		;;
	esac
	case $name in *[!A-Za-z0-9_]*)
		echo "$prog: $env_file line $lineno: invalid name" >&2
		exit 1
		;;
	esac
	case $value in
	\"*\") value=${value#\"} value=${value%\"} ;;
	\'*\') value=${value#\'} value=${value%\'} ;;
	esac
	export "$name=$value"
done <"$env_file"

# owner prints the uid that owns $1; sticky succeeds when folder $1 has the
# sticky bit. Both parse stat or ls output, since test -O and -k are not POSIX.
owner() {
	stat -c %u "$1" 2>/dev/null || stat -f %u "$1" 2>/dev/null || echo -1
}
sticky() {
	case $(ls -ld -- "$1" 2>/dev/null) in
	?????????[tT]*) return 0 ;;
	esac
	return 1
}
# gitroot prints the folder to mount for the resolved folder $1: the top of
# its git work tree, so .gitignore and .git/info/exclude are visible, or $1
# itself. It trusts only a .git that is ours and not a symlink, and never
# looks for one in or above a shared sticky folder such as /tmp.
me=$("$idcmd" -u)
gitroot() {
	r=$1
	d=$1
	while :; do
		if sticky "$d"; then break; fi
		if [ -e "$d/.git" ] || [ -L "$d/.git" ]; then
			if [ ! -L "$d/.git" ] && { [ -d "$d/.git" ] || [ -f "$d/.git" ]; } &&
				[ "$(owner "$d/.git")" = "$me" ]; then
				r=$d
			fi
			break
		fi
		if [ "$d" = / ]; then break; fi
		d=$(dirname -- "$d")
	done
	printf '%s' "$r"
}

# The folder is the git root of the working directory, which Claude Code
# sets to the project (or the active worktree); a .mcp.json can set the
# environment but not the working directory. CLAUDE_PROJECT_DIR must be set
# and lead to the same folder.
if [ -z "${CLAUDE_PROJECT_DIR:-}" ]; then
	echo "scree-mcp-docker: CLAUDE_PROJECT_DIR is not set; run it from Claude Code" >&2
	exit 1
fi
case $CLAUDE_PROJECT_DIR in
/*) ;;
*)
	echo "scree-mcp-docker: CLAUDE_PROJECT_DIR must be an absolute path" >&2
	exit 1
	;;
esac
pd=$(cd -P -- "$CLAUDE_PROJECT_DIR" 2>/dev/null && pwd -P) || {
	echo "scree-mcp-docker: cannot open CLAUDE_PROJECT_DIR $CLAUDE_PROJECT_DIR" >&2
	exit 1
}
wd=$(pwd -P) || {
	echo "scree-mcp-docker: cannot resolve the working directory" >&2
	exit 1
}
dir=$(gitroot "$wd")
if [ "$(gitroot "$pd")" != "$dir" ]; then
	echo "scree-mcp-docker: CLAUDE_PROJECT_DIR $pd is not in the repo of the working directory $dir; refusing" >&2
	exit 1
fi
case $dir in
*:*)
	echo "scree-mcp-docker: cannot mount $dir: the path contains ':'" >&2
	exit 1
	;;
esac
# Never mount the home directory, a folder above it, or /. Home is the one
# from the password database, so an inherited HOME cannot move it.
home=$(cd -P -- "$pwhome" 2>/dev/null && pwd -P) || home=$pwhome
refuse=
case $dir in / | "$home") refuse=1 ;; esac
case $home/ in "$dir"/*) refuse=1 ;; esac
if [ -n "$refuse" ]; then
	echo "scree-mcp-docker: refusing to mount $dir (your home directory, a folder above it, or /)" >&2
	exit 1
fi
opts=${SCREE_MOUNT_OPTS:-ro}
case $opts in
ro | ro,z | ro,Z) ;;
*)
	echo "scree-mcp-docker: SCREE_MOUNT_OPTS must be ro, ro,z or ro,Z" >&2
	exit 1
	;;
esac

# Build the argument list back to front. serve runs in the mounted folder,
# where it applies the same working-directory rule and the opt-in check.
set -- "${SCREE_IMAGE:-scree:latest}" serve
vol=${SCREE_DATA_VOLUME:-scree-data}
case $vol in
'' | [!A-Za-z0-9]* | *[!A-Za-z0-9_.-]*)
	echo "scree-mcp-docker: SCREE_DATA_VOLUME must be a volume name, not a path" >&2
	exit 1
	;;
esac
set -- -v "$dir:$dir:$opts" -v "$vol:/data" -w "$dir" -e "CLAUDE_PROJECT_DIR=$pd" "$@"
# Pass a variable only if it is set, so unset ones keep the image defaults.
for v in SCREE_HTTP_TOKEN SCREE_EMBED_URL SCREE_MAX_FILE_BYTES SCREE_FIRST_SYNC_MB SCREE_ZDR SCREE_DIMENSIONS SCREE_MODEL OPENROUTER_API_KEY; do
	if eval "[ -n \"\${$v+x}\" ]"; then
		set -- -e "$v" "$@"
	fi
done
# --pull=never: a missing local image must never be pulled from a registry,
# since the container receives the API key.
set -- run -i --rm --pull=never "$@"

# The child gets the passwd home and no XDG overrides, so a .mcp.json
# cannot move the index or the git config scree reads.
HOME=$pwhome
export HOME
unset XDG_DATA_HOME XDG_CONFIG_HOME
# Only docker or podman, found next to this script or on the system PATH, so
# the env file can't name an arbitrary program.
engine=${SCREE_DOCKER:-docker}
case $engine in
docker | podman) ;;
*)
	echo "scree-mcp-docker: SCREE_DOCKER must be docker or podman" >&2
	exit 1
	;;
esac
cmd=$(PATH="$here:$PATH" command -v "$engine") || {
	echo "scree-mcp-docker: $engine not found" >&2
	exit 1
}
exec "$cmd" "$@"
